# Project Vigilance - Environment Configuration Template
# Copy this file to .env and customize for your local or production environment.

# Backend Configuration (Node.js/Express)
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=24h

# ML Service Configuration (FastAPI)
ML_SERVICE_PORT=8000
ML_SERVICE_HOST=127.0.0.1
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=5000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/aml_detection

# Neo4j Graph Database Configuration (Neo4j Desktop / Local)
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=<local_neo4j_password>
NEO4J_DATABASE=neo4j

# Hardware & Pipeline Optimization
BATCH_SIZE=5000
MAX_GRAPH_DEPTH=2
